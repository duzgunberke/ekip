    * @returns `true` if migration was performed (= FTS index needs rebuilding).
    * @internal
    */
+  /** ekip patch: whether a vec0 table carries the agent_id partition key. */
+  private isPartitioned(table: string): boolean {
+    const row = this.db.prepare("SELECT sql FROM sqlite_master WHERE name = ?").get(table) as { sql?: string } | undefined;
+    return !!row?.sql && /partition key/i.test(row.sql);
+  }
+
+  /**
+   * ekip patch: rebuild a vec0 table with `agent_id` as its partition key (one time). Without it a
+   * KNN search scanned every agent's vectors (seconds, blocking the server) and then dropped the
+   * other agents' hits, so a small agent often got nothing. Vectors without a metadata row are
+   * orphans and are not carried over. On failure the old table stays and the store runs unpartitioned.
+   */
+  private migrateVecPartition(table: string, meta: string, timeCol: string): void {
+    const row = this.db.prepare("SELECT sql FROM sqlite_master WHERE name = ?").get(table) as { sql?: string } | undefined;
+    if (!row?.sql || /partition key/i.test(row.sql)) return;
+    const t0 = Date.now();
+    this.logger?.info(`${TAG} [ekip] partitioning ${table} by agent_id (one-time migration)`);
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      this.db.exec(`CREATE TEMP TABLE _ekip_vec_mig AS SELECT v.record_id AS record_id, v.embedding AS embedding, v.${timeCol} AS t, m.agent_id AS agent_id FROM ${table} v JOIN ${meta} m ON m.record_id = v.record_id`);
+      this.db.exec(`DROP TABLE ${table}`);
+      this.db.exec(`CREATE VIRTUAL TABLE ${table} USING vec0(record_id TEXT PRIMARY KEY, embedding float[${this.dimensions}] distance_metric=cosine, ${timeCol} TEXT DEFAULT '', agent_id TEXT partition key)`);
+      this.db.exec(`INSERT INTO ${table} (record_id, embedding, ${timeCol}, agent_id) SELECT record_id, embedding, t, agent_id FROM _ekip_vec_mig`);
+      this.db.exec("DROP TABLE _ekip_vec_mig");
+      this.db.exec("COMMIT");
+      this.logger?.info(`${TAG} [ekip] ${table} partitioned in ${Math.round((Date.now() - t0) / 1000)} s`);
+    } catch (err) {
+      try { this.db.exec("ROLLBACK"); } catch { /* not in a transaction */ }
+      this.logger?.warn(`${TAG} [ekip] ${table} partition migration failed, staying unpartitioned: ${err instanceof Error ? err.message : String(err)}`);
+    }
+  }

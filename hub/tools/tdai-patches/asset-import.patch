+// Session logs can exceed V8's max string length (~512 MB; e.g. a Claude Code session full of
+// base64 screenshots). Large files are read in chunks and lines over MAX_LINE (inline images,
+// file dumps) are dropped; the conversation text survives.
+const BIG_FILE = 256 * 1024 * 1024, MAX_LINE = 256 * 1024, MAX_TOTAL = 384 * 1024 * 1024;
+function readSessionText(path: string): string {
+  if (statSync(path).size <= BIG_FILE) return readFileSync(path, 'utf-8');
+  const fd = openSync(path, 'r');
+  const buf = Buffer.alloc(64 * 1024 * 1024);
+  const keep: string[] = [];
+  let carry: Buffer[] = [], carryLen = 0, dropping = false, total = 0;
+  try {
+    for (let n; (n = readSync(fd, buf, 0, buf.length, null)) > 0; ) {
+      let start = 0;
+      for (let i = buf.indexOf(10, 0); i !== -1 && i < n; i = buf.indexOf(10, i + 1)) {
+        if (!dropping && carryLen + (i - start) <= MAX_LINE && total < MAX_TOTAL) {
+          const line = Buffer.concat([...carry, buf.subarray(start, i)]).toString('utf-8');
+          // inline images ride on short lines too; they carry no conversation text
+          if (!line.includes('"type":"image"')) { keep.push(line); total += line.length; }
+        }
+        carry = []; carryLen = 0; dropping = false; start = i + 1;
+      }
+      if (start < n) {
+        if (dropping || carryLen + (n - start) > MAX_LINE) { dropping = true; carry = []; carryLen = 0; }
+        else { carry.push(Buffer.from(buf.subarray(start, n))); carryLen += n - start; }
+      }
+    }
+    if (!dropping && carryLen) keep.push(Buffer.concat(carry).toString('utf-8'));
+  } finally { closeSync(fd); }
+  return keep.join('\n');
+}

# ---- ekip hub ------------------------------------------------------------------------------
# Bearer token for /api/* (the Mac's ekip uses it). 16+ chars: openssl rand -hex 32
EKIP_HUB_TOKEN=
# Panel login password (10+ chars). Exchanged for an HttpOnly/Secure/SameSite=Strict cookie.
EKIP_HUB_PASSWORD=
# Optional HMAC secret for session cookies; when empty one is generated into /data/secret.
EKIP_HUB_SECRET=
# Parallel jobs (default 2).
EKIP_WORKERS=2
# Kill a worker after this many minutes (default 60).
EKIP_JOB_TIMEOUT_MIN=60
# Panel session lifetime in hours (default 168 = 7 days).
EKIP_SESSION_HOURS=168
# CLAUDE_CODE_AUTO_COMPACT_WINDOW for workers (default 100000).
EKIP_COMPACT_WINDOW=100000
# 1 = trust the last X-Forwarded-For hop for the login rate limit (compose sets it; Traefik in front).
EKIP_TRUST_PROXY=1
# 1 = allow local paths / file:// as project repos (tests only).
EKIP_ALLOW_LOCAL_REPOS=0

# ---- model endpoints -------------------------------------------------------------------------
# freellmapi (compose overrides the URL to http://freellmapi:3001).
FREELLMAPI_URL=http://freellmapi:3001
# freellmapi's unified API key (dashboard → Settings, or:
#   docker compose exec freellmapi node -e "const D=require('better-sqlite3');console.log(new D('/app/server/data/freeapi.db').prepare(\"select value from settings where key='unified_api_key'\").get().value)")
FREELLMAPI_KEY=
# freellmapi's at-rest encryption key (required in production): openssl rand -hex 32
FREELLMAPI_ENCRYPTION_KEY=

# TDAI memory proxy (on the external tdai-memory-stack network). Down -> jobs go to freellmapi directly.
TDAI_PROXY_URL=http://tdai-proxy:8096
# TDAI user key (sk-mem…, e.g. deploy/global-images/.admin-key), sent as the worker's API key.
TDAI_USER_KEY=

# ---- GitHub ----------------------------------------------------------------------------------
# Token with contents:read+write on the project repos (fine-grained PAT recommended). Sent only as an
# env-only git http.extraheader; never written to disk, argv or logs, never given to the worker.
GITHUB_TOKEN=

# TencentDB knowledge service (code graphs for the panel's Kod haritası).
KNOWLEDGE_URL=http://tdai-memory-hub:8424

# Other dashboards on the server, shown as links on the status page: "Name|https://url,Name|https://url"
EKIP_LINKS=

# ekip's own CI state (scripts/ci/vps-ci-poll.sh writes last-sha, result.json and mirror.git there),
# read by GET /api/ci and /api/release. Default: $EKIP_DATA/ci. EKIP_HUB_COMMIT (or the Docker build
# arg SOURCE_COMMIT) is the commit this hub runs, so the panel can say whether it is up to date.
EKIP_CI_DIR=

# GitHub Copilot CLI on the hub (strong models, your Copilot quota): a fine-grained PAT with the
# "Copilot Requests" permission. With it, jobs default to copilot and fall back to the free pool.
COPILOT_GITHUB_TOKEN=
